# 应用
APP_ENV=development
DEBUG=true
PORT=9096

# user-service 对接（本地 localhost；Docker 同网络内用服务名 user-service）
USER_SERVICE_URL=http://localhost:8000
JWKS_CACHE_TTL_SECONDS=3600

# meta-service 对接（本地 localhost；Docker 同网络内用服务名 meta-service）
META_SERVICE_URL=http://localhost:9093
META_TIMEOUT_SECONDS=10.0

# 配额
TOKEN_PER_REQUEST_LIMIT=15000
TOKEN_DAILY_LIMIT=100000

# 写端点内部密钥（仅 chat service 持有；逗号或 JSON 数组；为空=写端点禁用）
TOKEN_INTERNAL_KEYS=

# 故障策略（Meta 不可用时 check 拒绝）
TOKEN_FAIL_CLOSED=true

# 日志
LOG_LEVEL=INFO
